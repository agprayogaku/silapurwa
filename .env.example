# Port web server admin
PORT=3000

# Rahasia session admin (ubah di produksi)
SESSION_SECRET=silapurwa_rahasia_super_kamtib_2026_purwakarta

# Konfigurasi AI Gemini (opsional pada Tahap 1)
GEMINI_API_KEY=

# Kanal aktif: baileys | simulasi
# baileys = hubungkan nomor WhatsApp (pindai QR di http://localhost:3000/whatsapp)
# simulasi = uji tanpa WhatsApp
KANAL_AKTIF=simulasi

# Nomor WhatsApp bot untuk kode pairing (opsional).
# Kosongkan untuk memakai pemindaian QR. Format: 628xxxxxxxxxx
WA_PAIRING_NUMBER=

# Level log: trace | debug | info | warn | error
LOG_LEVEL=info
