# Konfigurasi Server Web
PORT=3000

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=silapurwa_db

# Konfigurasi WhatsApp Kamtib
# Format JID: 62xxxxxxxxxx@s.whatsapp.net (gunakan kode negara 62, tanpa +)
ADMIN_OFFICER_JID=62xxxxxxxxxx@s.whatsapp.net
# Format Group ID: didapat dari Baileys saat bot pertama bergabung ke grup
WHITELISTED_GROUPS=120363xxxxxxxxx@g.us
# Kredensial Panel Admin
ADMIN_PANEL_USERNAME=isi_username_admin
ADMIN_PANEL_PASSWORD=isi_password_yang_kuat
