<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | SILAPURWA
  </title>
  <link href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc2/dist/css/adminlte.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
    }

    .app-sidebar {
      background-color: #fff !important;
      border-right: 1px solid #dee2e6;
    }

    .sidebar-brand {
      border-bottom: 1px solid #dee2e6;
      padding: 1rem;
    }

    .nav-sidebar .nav-link {
      color: #495057;
      border-radius: 6px;
    }

    .nav-sidebar .nav-link:hover {
      background-color: #f1f3f5;
      color: #212529;
    }

    .nav-sidebar .nav-link.active {
      background-color: #0d6efd;
      color: #fff !important;
    }

    .nav-sidebar .nav-link.active .nav-icon {
      color: #fff !important;
    }

    .nav-icon {
      color: #868e96;
      width: 16px;
      text-align: center;
    }

    .nav-header {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .08em;
      color: #adb5bd;
      text-transform: uppercase;
      padding: 8px 12px 4px;
    }

    .app-header {
      background-color: #fff !important;
      border-bottom: 1px solid #dee2e6;
    }

    .card-stat {
      transition: transform .2s, box-shadow .2s;
    }

    .card-stat:hover {
      transform: translateY(-3px);
      box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .08) !important;
    }

    .badge-log {
      font-size: 11px;
      font-weight: 500;
    }
  </style>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
