<%- include('partials/header') %>
  <%- include('partials/sidebar') %>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="p-3 rounded-3 bg-primary-subtle text-primary">
              <i class="fa-solid fa-comments fa-2x"></i>
            </div>
            <div>
              <div class="text-muted small">FAQ Terdaftar</div>
              <div class="fs-4 fw-bold text-dark">
                <%= totalFaq %> Data
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="p-3 rounded-3 bg-danger-subtle text-danger">
              <i class="fa-solid fa-ban fa-2x"></i>
            </div>
            <div>
              <div class="text-muted small">Aturan Larangan Barang</div>
              <div class="fs-4 fw-bold text-dark">
                <%= totalLarangan %> Item
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="p-3 rounded-3 bg-success-subtle text-success">
              <i class="fa-solid fa-robot fa-2x"></i>
            </div>
            <div>
              <div class="text-muted small">Status Chatbot</div>
              <div class="fs-4 fw-bold text-success">Aktif</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="p-3 rounded-3 bg-warning-subtle text-warning">
              <i class="fa-solid fa-headset fa-2x"></i>
            </div>
            <div>
              <div class="text-muted small">Antrean Admin Manual</div>
              <div class="fs-4 fw-bold text-dark">
                <%= totalSesiAdmin %> Sesi
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Banner -->
    <div class="alert border-start border-primary border-4 bg-white shadow-sm mb-4 py-3" role="alert">
      <h6 class="fw-bold text-secondary mb-1">Selamat Datang di Panel Admin SILAPURWA</h6>
      <p class="mb-0 text-muted small">Kelola basis data respons otomatis Chatbot WhatsApp layanan publik Lapas Kelas
        IIB Purwakarta secara real-time melalui panel ini.</p>
    </div>

    <!-- Log chat -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
        <h6 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Log Aktivitas Chatbot
          (Real-Time)</h6>
        <button class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
          <i class="fa-solid fa-rotate me-1"></i> Segarkan
        </button>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:13px;">
            <thead class="table-light">
              <tr>
                <th class="px-3" width="18%">Waktu</th>
                <th width="20%">Pengirim</th>
                <th width="32%">Pesan Masuk</th>
                <th width="30%">Respons Sistem</th>
              </tr>
            </thead>
            <tbody>
              <% if (!logs || logs.length===0) { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    <i class="fa-regular fa-comment-dots fa-2x mb-2 d-block"></i>
                    Belum ada aktivitas chat yang terekam.
                  </td>
                </tr>
                <% } else { %>
                  <% logs.slice(0, 20).forEach(log=> { %>
                    <tr>
                      <td class="px-3 text-muted small">
                        <%= log.waktu %>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark small">
                          <%= log.pushName || 'Keluarga WBP' %>
                        </div>
                        <div class="text-muted" style="font-size:11px;">
                          <%= log.whatsapp?.split('@')[0] || log.phoneNumber?.split('@')[0] || 'Sistem' %>
                        </div>
                      </td>
                      <td class="text-muted small">
                        <%= log.pesan || log.message %>
                      </td>
                      <td>
                        <% const tipe=log.tipe || log.responseType || '' ; %>
                          <% if (tipe.includes('FAQ')) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle badge-log"><i
                                class="fa-solid fa-robot me-1"></i>
                              <%= tipe %>
                            </span>
                            <% } else if (tipe.includes('Fallback') || tipe.includes('Menu')) { %>
                              <span
                                class="badge bg-secondary-subtle text-secondary border border-secondary-subtle badge-log"><i
                                  class="fa-solid fa-circle-exclamation me-1"></i>Menu Utama</span>
                              <% } else { %>
                                <span
                                  class="badge bg-danger-subtle text-danger border border-danger-subtle badge-log"><i
                                    class="fa-solid fa-user-shield me-1"></i>
                                  <%= tipe || 'Manual' %>
                                </span>
                                <% } %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Aksi cepat -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom py-3">
        <h6 class="fw-bold mb-0"><i class="fa-solid fa-bolt text-warning me-2"></i>Aksi Pengelolaan Cepat</h6>
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
          <a href="/admin-panel/faq" class="btn btn-primary px-4"><i class="fa-solid fa-pen-to-square me-2"></i>Perbarui
            Data FAQ</a>
          <a href="/admin-panel/layanan" class="btn btn-outline-secondary px-4"><i
              class="fa-solid fa-calendar-days me-2"></i>Atur Jadwal Kunjungan</a>
          <a href="/admin-panel/audit-log" class="btn btn-outline-info px-4"><i
              class="fa-solid fa-clipboard-list me-2"></i>Lihat Riwayat Aktivitas</a>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
